// CI-specific configuration for building archives
//
// NOTE: Library evolution is DISABLED because the Carthage-built LoopKit
// from loop-release/v2.x does not have library evolution enabled.
// Mixing frameworks with and without library evolution causes build failures.
//
// The CI build is for validation only, not for distribution, so we don't
// need library evolution support.

// Disable library evolution to match dependencies
BUILD_LIBRARY_FOR_DISTRIBUTION = NO

// No code signing
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =

// Don't skip install
SKIP_INSTALL = NO
