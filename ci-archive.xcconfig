// CI-specific configuration for building xcframeworks
// Workaround for ASN1/Digest module interface verification issues with Xcode 16.4

// Enable library evolution for distribution
BUILD_LIBRARY_FOR_DISTRIBUTION = YES

// Skip module interface verification to work around ASN1 2.8.0 bugs
// The .swiftinterface files will still be generated but won't be verified
SWIFT_EMIT_MODULE_INTERFACE = YES
OTHER_SWIFT_FLAGS = -no-verify-emitted-module-interface

// No code signing
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =

// Don't skip install
SKIP_INSTALL = NO
